{
	"name": "obsidian-chronoccg",
	"version": "1.0.0",
	"description": "Obsidian plugin for the ChronoCCG card game.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "node scripts/test.mjs",
		"version": "node scripts/version-bump.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"ccg",
		"tcg",
		"chrono"
	],
	"author": "Merlin Deramaix",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.21.0",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0"
	}
}
